{
  "name": "baldie81/shopify-gql-sdk",
  "description": "Framework-independent PHP SDK for the Shopify Admin GraphQL API.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "shopify",
    "graphql",
    "admin-api",
    "sdk",
    "ecommerce",
    "guzzle"
  ],
  "authors": [
    {
      "name": "baldie81"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.15.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^10.5",
    "webonyx/graphql-php": "^15"
  },
  "autoload": {
    "psr-4": {
      "Baldie81\\ShopifyGraphQL\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Baldie81\\ShopifyGraphQL\\Tests\\": "tests/",
      "Baldie81\\ShopifyGraphQL\\Examples\\": "examples/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress --memory-limit=1G",
    "schema": "@php bin/fetch-schema.php",
    "check": [
      "@stan",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts-descriptions": {
    "schema": "Download Shopify's Admin GraphQL schema so the schema-validation test can run.",
    "check": "Static analysis + tests."
  }
}
